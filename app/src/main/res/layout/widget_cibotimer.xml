<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_2x1_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_fasting"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:gravity="center_vertical">

    <!-- Colonna testi a sinistra (weight 1, minWidth 0), tre righe -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:minWidth="0dp"
        android:layout_marginEnd="6dp"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <!-- 1. Stato 11dp colore secondario -->
        <TextView
            android:id="@+id/widget_2x1_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#8FA3BF"
            android:textSize="11dp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- 2. Tempo 22dp bianco medium, maxLines=1 (autosize fino a 18dp) -->
        <TextView
            android:id="@+id/widget_2x1_time_remaining"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#FFFFFF"
            android:textSize="22dp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:maxLines="1"
            android:ellipsize="end"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="18dp"
            android:autoSizeMaxTextSize="22dp"
            android:autoSizeStepGranularity="1dp" />

        <!-- 3. Prossimo evento 12dp, colore chiaro, maxLines=2 (può andare a capo, es. "Mangiare alle / 7:00") -->
        <TextView
            android:id="@+id/widget_2x1_next_period"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#FFFFFF"
            android:textSize="12dp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Pulsante circolare 32dp (icona 17dp) a destra, non comprimibile, area touch >= 44dp -->
    <FrameLayout
        android:id="@+id/widget_2x1_action_container"
        android:layout_width="44dp"
        android:layout_height="44dp">

        <ImageView
            android:id="@+id/widget_2x1_action_button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:background="@drawable/widget_button_circle_fasting"
            android:padding="7.5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_flame"
            android:contentDescription="@string/widget_action_eat" />
    </FrameLayout>

</LinearLayout>
