<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_2x1_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_fasting"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:gravity="center_vertical">

    <!-- Colonna testi a sinistra (weight 1, minWidth 0), tre righe -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:minWidth="0dp"
        android:layout_marginEnd="4dp"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <!-- 1. Stato 11dp colore secondario -->
        <TextView
            android:id="@+id/widget_2x1_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#8FA3BF"
            android:textSize="11dp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- 2. Tempo rimanente (es. "14h 38m"): textSize 22dp, maxLines=1 (autosize fino a 14dp se lo spazio è ridotto) -->
        <TextView
            android:id="@+id/widget_2x1_time_remaining"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="#FFFFFF"
            android:textSize="22dp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:maxLines="1"
            android:ellipsize="end"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="14dp"
            android:autoSizeMaxTextSize="22dp"
            android:autoSizeStepGranularity="1dp" />

        <!-- 3. Prossimo evento 11.5dp, colore chiaro, maxLines=2 (può andare a capo, es. "Mangiare alle / 7:00") -->
        <TextView
            android:id="@+id/widget_2x1_next_period"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="#FFFFFF"
            android:textSize="11.5dp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Pulsante circolare 30dp (icona 17dp) a destra, area touch compatta >= 38dp -->
    <FrameLayout
        android:id="@+id/widget_2x1_action_container"
        android:layout_width="38dp"
        android:layout_height="38dp">

        <ImageView
            android:id="@+id/widget_2x1_action_button"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:background="@drawable/widget_button_circle_fasting"
            android:padding="6.5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_flame"
            android:contentDescription="@string/widget_action_eat" />
    </FrameLayout>

</LinearLayout>
