<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Include database Room e SQLite -->
        <include domain="database" path="." />
        <!-- Include file di persistenza interni e backup locali -->
        <include domain="file" path="." />
        <!-- Include preferenze dell'applicazione -->
        <include domain="sharedpref" path="." />
        <!-- Escludi cache interna ed esterna -->
        <exclude domain="root" path="cache" />
    </cloud-backup>
    <device-transfer>
        <!-- Include dati completi durante il trasferimento tra dispositivi -->
        <include domain="database" path="." />
        <include domain="file" path="." />
        <include domain="sharedpref" path="." />
        <exclude domain="root" path="cache" />
    </device-transfer>
</data-extraction-rules>
